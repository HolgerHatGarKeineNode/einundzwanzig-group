<?xml version="1.0" encoding="UTF-8"?>
<!--
    The Pest BROWSER category (real Chromium, host binary via ensureHostChromium() in
    tests/Pest.php). Not part of phpunit.xml, so `php artisan test` stays a seconds-long loop.

    Start:  composer test:browser          (composer appends further arguments to the one
            command — keep it a single shell command, like the companion repo does)
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_LOCALE" value="de"/>
        <env name="APP_FALLBACK_LOCALE" value="de"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Pest-Browsertests: Host-Chromium statt Download. Playwrights Browser-
             Registry (per Symlink auf /bin/chromium, siehe ensureHostChromium())
             liegt projekt-lokal; relativ zum Projekt-Root aufgelöst (auch vom
             `playwright run-server`-Subprozess). -->
        <env name="PLAYWRIGHT_BROWSERS_PATH" value="tests/Browser/browsers"/>
    </php>
</phpunit>
