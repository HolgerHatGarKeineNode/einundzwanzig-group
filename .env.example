APP_NAME=EINUNDZWANZIG
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Fixierter Default-Space der Web-Client-Insel (leer = lokaler Test-Relay).
# Prod: wss://group.einundzwanzig.space/
#
# ACHTUNG: Es ist nur der DEFAULT. Hat der Browser `activeSpaceUrl` im
# localStorage (jeder Space-Wechsel schreibt ihn), gewinnt der — eine Aenderung
# hier erreicht bestehende Nutzer NICHT. Rueckfallweg fuer Betroffene:
# `localStorage.removeItem('activeSpaceUrl')` in der Konsole.
#
# Und weil `.env` gitignored ist, ueberlebt ein hier eingetragener Test-Relay
# jeden Branch-Wechsel. Genau das hat am 2026-07-29 eine E2E-Basislinie
# verfaelscht (157 rot von 315), bis `partials/head.blade.php` den Wert per `??`
# statt per Zuweisung setzte — seitdem schlaegt der von der Suite gesetzte Space
# diesen Default.
NOSTR_SPACE_URL=

# Quelle der Longform-Artikel (P7, kind 30023) — der oeffentliche Vereins-Relay,
# NICHT der Space oben. Leer = der Artikel-Screen zeigt seinen Leerzustand und
# fragt keinen Relay. Bewusst ohne Default im Code: sonst oeffnete eine fehlende
# Konfiguration still eine Verbindung ins oeffentliche Internet — auch aus jedem
# Testlauf. Produktiv: wss://nostr.einundzwanzig.space
NOSTR_BOARD_URL=

# P6 — Relays der SOZIALSIGNALE zu den Artikeln (kind 7 Reaktionen, 9735 Zap-Quittungen,
# 1111 Kommentare), kommagetrennt. Die Artikel selbst (kind 30023) kommen weiterhin
# AUSSCHLIESSLICH vom Board oben; von diesen Adressen werden nur die drei Kinds geholt.
# Ebenfalls ohne Default im Code, aus demselben Grund wie oben — und zusaetzlich, weil
# der Relay-Waechter der E2E-Suite fail-closed ist: eine eingebaute Fremdadresse machte
# jeden Test rot, der eine Artikelflaeche beruehrt.
# Leer = nur der Board wird gefragt. Gemessen am 2026-08-21 ueber alle 104 Artikel sieht
# der Board 14 % der Reaktionen, 3 % der Zaps und 20 % der Kommentare — die Zaehler sind
# dann kleiner, nichts bricht.
#
# WAS DIESE RELAYS UEBER DEINE LESER ERFAHREN — bevor du sie setzt:
# Jede hier eingetragene Adresse bekommt beim BLOSSEN OEFFNEN einer Artikelflaeche,
# ohne Klick und ohne Zutun des Lesers, eine Verbindung und damit seine IP-Adresse,
# seinen User-Agent, den Zeitpunkt und die angefragten Filter — also WELCHE ARTIKEL
# dieser Leser gerade ansieht (die Vollansicht fragt mit genau einer Adresse).
# Der PUBKEY geht nicht hinaus: NIP-42-AUTH-Challenges dieser Relays werden seit P6
# ausdruecklich nicht mehr beantwortet (js/core.ts, `darfAuthBekommen`).
#
# EIN ZWEITER ABFLUSS, den diese Variable NICHT abschaltet: um eine Zap-Quittung zu
# validieren, holt der Client die LNURL-Metadaten des ARTIKEL-AUTORS per HTTPS von
# dessen fremdem Wallet-Host (getalby.com, primal.net, walletofsatoshi.com …) — ebenfalls
# beim blossen Oeffnen der Liste. Der Host erfaehrt IP, Zeitpunkt UND WELCHEN AUTOR (der
# Pfad traegt dessen lud16-Namen; auf der Vollansicht ist das genau einer) — NICHT aber,
# welchen Artikel jemand liest: der Referer traegt nur den Origin, nie den naddr.
# Unvermeidbar (ohne Zapper verwirft welshman jede Quittung), aber an den Bedarf
# gekoppelt: angefragt werden nur Autoren mit Quittungen — gemessen 6 von 12, ohne
# Metrik-Relais und ohne Board-Zaps null. Die 6 ist eine Bestandsmessung, keine Zusage:
# mit gefaelschten Quittungen ist sie auf 12 zurueckdrehbar. Den Host waehlen kann ein
# Dritter dabei nicht.
#
# WAS DIESE VARIABLE LEISTET, GENAU: leer lassen schaltet die METRIK-RELAIS ab. Die
# LNURL-Anfragen schaltet sie nicht direkt ab; sie fallen nur weitgehend mit weg, weil
# ohne die Fremdrelais kaum Quittungen eintreffen (der Board traegt 5 von 168). Ein Opt-in
# in der Oberflaeche gibt es bewusst nicht — die Entscheidung liegt hier, an einer Stelle.
# Produktiv empfohlen: wss://nos.lol,wss://relay.damus.io
NOSTR_ARTICLE_METRIC_RELAYS=

# ── NIP-52-Kalender: Meetup-Termine im Raumkopf (P2) ────────────────────
# Die Relays, auf denen die TERMINE eines Meetups liegen (kind 31923) und auf die
# dieser Client seine Zusagen schreibt (kind 31925). Kommagetrennt.
#
# Das ist die Adresse des PORTALS, nicht unsere. Das Vereins-Portal signiert und
# publiziert seine Meetups (31924) und Termine (31923) seit dem 2026-09-04 selbst,
# alle fuenf Minuten, auf die Relays aus SEINEM NOSTR_RELAYS (einundzwanzig-portal,
# config/services.php, Default wss://nos.lol,wss://relay.damus.io). Weicht die
# Prod-Instanz des Portals davon ab, gehoert hier IHR Wert hinein.
#
# Leer = die Terminkarte zeigt weiter den Termin aus der HTTP-Liste des Portals
# (/api/mobile/meetups) und schickt KEINEN REQ. Kein Default im Code, aus demselben
# Grund wie bei NOSTR_BOARD_URL: sonst verbaende sich jede Installation und jeder
# Testlauf ungefragt mit fremden Relays.
#
# WAS DIESE RELAYS UEBER DEINE LESER ERFAHREN: beim BLOSSEN OEFFNEN eines
# MEETUP-Raums, ohne Klick, bekommen sie IP, User-Agent, Zeitpunkt und die
# angefragten Filter — also WELCHES MEETUP dieser Leser gerade ansieht (der Filter
# traegt genau eine Koordinate). Der PUBKEY geht dabei nicht hinaus: js/relayConfig.ts
# nimmt diese Adressen in dieselbe AUTH-Sperre auf wie die Metrik-Relais darueber.
# Wer auf einen Termin zusagt, gibt seinen Pubkey natuerlich preis — ein kind 31925
# traegt ihn im Klartext. Das geschieht aber nur auf Knopfdruck.
# Produktiv empfohlen: wss://nos.lol,wss://relay.damus.io
NOSTR_CALENDAR_RELAYS=

# Die Pubkeys (HEX, kommagetrennt), deren kind 31923 als Termin eines Meetups gilt.
# OHNE diesen Wert fragt der Client gar nichts ab — und das ist Absicht.
#
# Der Autorenfilter ist die halbe Flaeche, keine Haertung: kind 31923 ist ein
# oeffentliches Kind auf oeffentlichen Relays, und das `a`-Tag, mit dem ein Termin an
# einen Meetup-Kalender gebunden wird, ist eine BEHAUPTUNG. Jeder darf ein Event mit
# unserer Koordinate publizieren. Gemessen 2026-09-05 lieferte ein blanker
# `nak req -k 31923 -l 100 wss://nos.lol` 100 Events von 16 Autoren — Baseballspiele,
# brasilianische Konzerte und zwei verschiedene Schluessel, die die Termine desselben
# oesterreichischen Clubs byte-gleich publizieren. Ohne authors stuende im Raumkopf,
# was ein Fremder dorthin zeigt.
#
# HEX, nicht npub: ein npub1… matcht kein einziges Event, und „matcht nichts" sieht
# genauso aus wie „dieses Meetup hat keine Termine".
#
# Eine Liste ist vorgesehen, weil die Kalender-Koordinate den Autor enthaelt
# (31924:<pubkey>:meetup-<id>): nach einer Schluesselrotation waeren sonst alle vorher
# publizierten Termine unauffindbar. Beide Schluessel eintragen, alt zuletzt.
#
# Produktiv (gemessen 2026-09-05 auf nos.lol; kind 0 „Einundzwanzig Portal",
# website portal.einundzwanzig.space, npub1mturmynk3dwsqpfh87p7xr2zq0qtw37pwpzfuqh75cg6pksjtmnqqxv6kw):
# daf83d92768b5d0005373f83e30d4203c0b747c170449e02fea611a0da125ee6
NOSTR_CALENDAR_AUTHORS=

# Workspace-Relay (Buzz). **Schema ist Pflicht: `wss://`.** Ohne Schema laeuft der
# Client weiter korrekt (welshmans `normalizeRelayUrl` setzt `wss://` selbst davor),
# der SERVERSEITIGE Medien-Riegel im ImageProxyController wird aber WIRKUNGSLOS —
# `new Uri('host.tld')` liest den String als Pfad und findet keinen Host. Der Fehler
# ist sonst unsichtbar: nichts geht kaputt, kein Test wird rot. Seit dem Audit vom
# 2026-08-19 meldet der Controller so einen Eintrag als Warnung ins Log.
# Leer = keine Workspace-Funktionen, und der Riegel ist legitim inert.
# Produktiv: wss://buzz.einundzwanzig.space
NOSTR_WORKSPACE_URL=

# ── Vereins-Proxy (P4) ──────────────────────────────────────────────────
# Origin der Vereins-Instanz, OHNE Pfad und OHNE Schraegstrich am Ende
# (produktiv z.B. https://verein.einundzwanzig.space). Muss zeichengenau dem
# APP_URL-Origin des VEREINS entsprechen: er prueft den `u`-Tag des
# NIP-98-Events byteweise dagegen, ein `www.` oder ein Port zu viel laesst
# jeden Aufruf mit 401 scheitern.
VEREIN_API_URL=
# Client-Schluessel der Vereins-API (Header X-Api-Key). Der Browser sieht ihn
# nie — genau dafuer gibt es den Proxy. NICHT VEREIN_GATE_TOKEN, das gehoert
# zu einer anderen API (Portal, Bearer). Leer = der Proxy antwortet 503 und
# ruft nichts auf.
VEREIN_API_KEY=

# ── Vereins-Onboarding (P5) ─────────────────────────────────────────────
# VEREIN_API_URL von oben wird zusaetzlich in den Browser gegeben
# (window.__nostrVerein.api): der `u`-Tag der NIP-98-Ausweise zielt auf den
# VEREIN, nicht auf unsere Proxy-Route. Kein Geheimnis — der X-Api-Key bleibt
# serverseitig. Leer = der Beitritts-Flow existiert nicht, das Vereins-Gate
# verlinkt wie bisher nach draussen.
#
# Wartezeit von der bestaetigten Zahlung bis zur Freischaltung, in MINUTEN.
# DER EINE WERT: jede Dauer-Angabe im Wartezustand liest ihn. Heute ist die
# Wahrheit 1440 (naechtlicher Cron um 00:30). Nach P1 (viertelstuendlich) hier
# 15 eintragen — kein Text ist umzuschreiben. Leer/0 = keine Dauer nennen.
VEREIN_ACTIVATION_MINUTES=
# Origin des Vereins-Proxys. Leer = derselbe Origin wie die Seite. Nur der
# NativePHP-/Fremdhost-Build braucht einen Wert: dort ist der Proxy NICHT
# registriert (er haelt ein Geheimnis und laeuft nur in der Web-Instanz), der
# Build ruft ihn deshalb ueber HTTPS bei der Web-Instanz auf.
VEREIN_PROXY_BASE=
# Oeffentliche Vereinsseite — der sichtbare Ausweg, wenn der Weg im Client
# nicht traegt (Proxy nicht konfiguriert, unerwartete Weiterleitung, keine
# Zahlmethode). Default: https://verein.einundzwanzig.space/
VEREIN_PUBLIC_URL=
# Oeffentliche Creator-Seite des eigenen Oekosystems — Ziel der Profil-Verweise
# („Profil auf … ansehen" in der Profilkarte und auf der Autorenseite).
#
# DER WERT IST DAS GANZE PRAEFIX VOR /u/…, nicht nur der Host. Der Klarpfad
# (…/u/<nip05|npub>) ist der Default, weil er profilspezifische OG-Tags liefert:
# ein geteilter Link zeigt Name und Bild des Autors statt einer generischen
# Karte. Es ist dieselbe Form, die media. im eigenen Teilen-Dialog baut.
#
# WER DIE REINE SPA-ROUTE WILL, haengt ein `#` an — DANN ABER IN
# ANFUEHRUNGSZEICHEN: phpdotenv schneidet ein unquotiertes `#` samt Rest ab
# (2026-08-21 gemessen), und weil media. BEIDE Formen beantwortet, faellt der
# Rueckfall auf den Klarpfad niemandem auf. Richtig also:
#   MEDIA_PUBLIC_URL="https://media.einundzwanzig.space/#"
#
# LEER LASSEN SCHALTET DEN VERWEIS AB: dann steht die Zeile auf beiden Flaechen
# gar nicht erst da, statt auf eine kaputte Adresse zu zeigen.
MEDIA_PUBLIC_URL=https://media.einundzwanzig.space

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Wegwerf-nsec NUR für E2E-Login-Tests (M1.5) — kein realer Key, kein Wert.
NOSTR_TEST_NSEC=nsec1wmtsjwzs3zm4q9cg2fcpg0z99yxq649kyp8yl8cgm4jmsjscppfs43avez

# Zweite Wegwerf-Identität, NUR für E2E-Tests, die zwei echte Pubkeys brauchen
# (Präsenz, DMs) statt zwei Tabs auf demselben Schlüssel — kein realer Key, kein Wert.
NOSTR_TEST2_NSEC=nsec1hex7trcqqup5tpfthfs5u2pufau0p95dehg0j53cn2w9all95thqxfvjpq

# Autobot fürs `bot:announce`-Command (rein lokal, siehe dortiger Klassen-
# Kommentar). Ohne NSEC bricht das Command sauber ab.
# NOSTR_BOT_NSEC=
# NOSTR_BOT_RELAY=
# Optionaler Pfad-Override zum `nak`-Binary, sonst PATH bzw. ~/go/bin/nak.
# NAK_BIN=

# E2E-Server-Isolation: zeigt auf einen nicht existierenden Pfad, damit der
# E2E-Port (8137) immer Build-Assets nutzt und parallel zum HMR-Dev (8000)
# laufen kann. Siehe App\Providers\AppServiceProvider::boot().
# VITE_HOT_FILE=

SESSION_DRIVER=database
# 1 Jahr (60*24*365) — der Nostr-Login (via NIP-98-Handoff) soll Wiederkehr nach
# Tagen/Wochen überleben, nicht nach 2h neu signieren müssen. DB-Sessions rollieren
# automatisch (last_activity pro Request), Cookie-Max-Age leitet Laravel daraus ab.
SESSION_LIFETIME=525600
# false pinnen: bei true stürbe das Cookie beim Browser-Schließen (Session-Cookie).
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── NativePHP Mobile ────────────────────────────────────────────────────
NATIVEPHP_APP_ID=space.einundzwanzig.group
NATIVEPHP_APP_VERSION=DEBUG
NATIVEPHP_APP_VERSION_CODE=1
NATIVEPHP_START_URL=/nostr-smoke
NATIVEPHP_DEEPLINK_SCHEME=einundzwanziggroup
NATIVEPHP_DEEPLINK_HOST=group.einundzwanzig.space
NATIVEPHP_ANDROID_COLOR_PRIMARY="#F7931A"
NATIVEPHP_ANDROID_COLOR_PRIMARY_NIGHT="#F7931A"
NATIVEPHP_ANDROID_COLOR_ON_PRIMARY="#0A0A0A"
NATIVEPHP_ANDROID_SDK_LOCATION=/home/user/Android/Sdk
