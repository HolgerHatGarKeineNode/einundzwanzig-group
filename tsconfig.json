{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        // Die reinen Logik-Module unter `packages/*/js/` importieren einander MIT
        // `.ts`-Endung — sie muessen aus Vite UND aus `node --test` ladbar sein, und
        // der Node-Test-Runner loest ohne Endung nicht auf. Ohne dieses Flag meldet
        // der Editor dort TS5097, obwohl Build und Tests gruen sind. `noEmit` ist
        // gesetzt, die Bedingung des Flags also erfuellt.
        "allowImportingTsExtensions": true,
        "types": []
    },
    // `resources/js/app.ts` importiert das Package und zieht `bridge.ts` damit
    // transitiv in DIESES Projekt. Dessen Ambient-Deklarationen (`qrcode.d.ts`,
    // `css.d.ts`) liegen aber daneben und wären ohne den zweiten Glob nicht
    // sichtbar — die Folge waren zwei Fehler über Module, für die genau hier eine
    // Deklaration bereitliegt. Nur `.d.ts`: die Implementierungsdateien haben ihr
    // eigenes Projekt (`packages/*/js/tsconfig.json`) und gehören nicht doppelt geprüft.
    "include": ["resources/js/**/*.ts", "packages/*/js/**/*.d.ts"]
}
