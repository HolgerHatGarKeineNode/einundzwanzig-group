{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        // Die reinen Logik-Module unter `packages/*/js/` importieren einander MIT
        // `.ts`-Endung — sie muessen aus Vite UND aus `node --test` ladbar sein, und
        // der Node-Test-Runner loest ohne Endung nicht auf. Ohne dieses Flag meldet
        // der Editor dort TS5097, obwohl Build und Tests gruen sind. `noEmit` ist
        // gesetzt, die Bedingung des Flags also erfuellt.
        "allowImportingTsExtensions": true,
        "types": []
    },
    // `resources/js/app.ts` imports the package and so pulls `bridge.ts` into THIS
    // project transitively. Its ambient declarations (`qrcode.d.ts`, `url-import.d.ts`)
    // sit next to it and would be invisible without the second glob — that once gave
    // errors about modules whose declaration is right there. Only `.d.ts`: the
    // implementation files have their own project (`packages/*/js/tsconfig.json`) and
    // are not checked twice. (`css.d.ts` went with cropperjs 2, which ships no CSS.)
    "include": ["resources/js/**/*.ts", "packages/*/js/**/*.d.ts"]
}
