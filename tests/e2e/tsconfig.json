{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["node"],
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noEmit": true,
        // Siehe tsconfig.json in der Repo-Wurzel: die Logik-Specs importieren die
        // reinen Module aus `packages/*/js/` mit `.ts`-Endung.
        "allowImportingTsExtensions": true
    },
    "include": ["**/*.ts"]
}
