{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test:unit": "node --test --experimental-strip-types \"packages/*/js/**/*.test.ts\" \"tests/**/*.nodetest.ts\"",
        "test:e2e": "playwright test",
        "test:e2e:buzz": "E2E_RELAY=buzz playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:buzz:headed": "E2E_RELAY=buzz playwright test --headed",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/e2e/tsconfig.json --noEmit && tsc -p packages/einundzwanzig-group/js/tsconfig.json --noEmit"
    },
    "dependencies": {
        "@einundzwanzig/group": "file:packages/einundzwanzig-group",
        "@fontsource/inconsolata": "^5.2.8",
        "@tailwindcss/vite": "^4.1.11",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "playwright": "^1.59.1",
        "tailwindcss": "^4.0.7",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.59.1",
        "@types/node": "^26.1.0",
        "typescript": "^5.9.3"
    }
}
