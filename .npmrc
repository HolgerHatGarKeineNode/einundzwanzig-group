ignore-scripts=true
audit=true
# Quarantaene: keine Paketversion juenger als 7 Tage (keyv/cacheable-Angriff 2026-08-04).
# ACHTUNG, zwei gemessene Einschraenkungen — die Regel deckt weniger ab, als sie aussieht:
#  1. Sie gilt nur beim AUFLOESEN (npm install). `npm ci` wertet sie NICHT aus: gemessen am
#     2026-08-29 mit einem 6,53 Tage alten Paket — `npm install` bricht mit ETARGET ab,
#     `npm ci` installiert es aus der Lockfile ohne Murren. Das hier ist eine
#     Arbeitsplatz-Regel, KEINE Pipeline-Regel und keine Lieferketten-Zusage des Projekts.
#     Die Vertrauensgrenze ist die package-lock.json, nicht diese Zeile.
#  2. Diese Lockfile enthaelt eine bewusste AUSNAHME: die sieben @welshman/*-Pakete auf
#     0.9.5 (publiziert 2026-08-22T22:16Z) wurden am 2026-08-29 mit
#     `npm_config_min_release_age=0` aufgeloest, also 6 Tage vor Ablauf der Quarantaene.
#     Geprueft wurde stattdessen von Hand: `npm audit signatures` ueber 252 Pakete, alle
#     Registry-Signaturen gueltig. Wer hier "nichts juenger als sieben Tage" liest, liest
#     fuer diese Lockfile falsch.
min-release-age=7
